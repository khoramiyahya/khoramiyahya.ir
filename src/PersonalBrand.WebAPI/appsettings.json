{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=PersonalBrandPlatform;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "PersonalBrandPlatform",
    "Audience": "PersonalBrandPlatform.Clients",
    "SigningKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS",
    "AccessTokenExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "BootstrapAdmin": {
    "Email": "",
    "Password": "",
    "DisplayName": "Administrator"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
